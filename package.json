{
  "name": "kairotron",
  "version": "0.1.0",
  "description": "Text-first REPL for discrete-time dynamical systems (stock-and-flow folds)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "kairotron": "src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "run": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

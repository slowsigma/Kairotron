{
  "name": "kairotron",
  "version": "0.1.0",
  "description": "Text-first REPL for discrete-time dynamical systems (stock-and-flow folds)",
  "type": "module",
  "license": "MIT",
  "files": [
    "bin",
    "src",
    "examples",
    "README.md"
  ],
  "bin": {
    "kairotron": "bin/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "dev": "vite",
    "build": "vite build",
    "build:bin": "tsc -p tsconfig.bin.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:bin",
    "preview": "vite preview",
    "run": "tsx src/cli.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:examples": "tsx scripts/check-doc-examples.ts",
    "docs:check": "npm run docs:examples && npm run docs:build"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
